# ─────────────────────────────────────────────────────────────────────────────
# ApplyAI — Environment Variables Template
#
# Copy this file to .env and populate the values you need.
# .env is gitignored and must never be committed.
#
# DISTINCTION: These keys are for the ApplyAI Python application at RUNTIME.
# They are NOT related to the Antigravity IDE or development agent session.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path (default). For PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/apply_ai.db

# ── AI Provider (both optional; V1 runs without any AI key configured) ─────────
# Set provider in config/settings.yaml → ai.provider: "anthropic" | "gemini" | "none"

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI (Gemini via google-genai SDK) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Application ───────────────────────────────────────────────────────────────
# Path to candidate profile directory (default: ./candidate/private)
# Set to candidate/example to use synthetic example data
CANDIDATE_PROFILE_DIR=candidate/private

# Path to application settings
SETTINGS_PATH=config/settings.yaml
